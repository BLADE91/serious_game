DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-plus

# 旧的非章节式流程可选 qwen 或 pa_backend；章节式流程固定由 PA Backend 创作、Qwen Flash 审查和抽取。
SCRIPT_GENERATION_BACKEND=qwen

OPENSEARCH_HOST=your_opensearch_host
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your_opensearch_password_here
OPENSEARCH_INDEX=serious_game_sources

PA_BACKEND_BASE_URL=https://apitest.know-pa.cn
PA_BACKEND_ACCOUNT=
PA_BACKEND_PASSWORD=
PA_BACKEND_LOGIN_ENDPOINT=/api/auth/sso/login-password
PA_BACKEND_AGENT_ENDPOINT=/agent/os-search/general
PA_BACKEND_COLLECTION_ID=
PA_BACKEND_SUPABASE_URL=https://your-project.supabase.co
PA_BACKEND_SUPABASE_KEY=your_supabase_anon_or_service_key
PA_BACKEND_SEARCH_PREFERENCE=breadth
PA_BACKEND_ENABLE_WEB_SEARCH=true
PA_BACKEND_VERIFY_SSL=true
PA_BACKEND_MAX_STAGE_RETRIES=2
PA_BACKEND_RETRY_BACKOFF_SECONDS=2
