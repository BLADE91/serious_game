# 复制为 .env 后填写；.env 已被仓库根目录 .gitignore 排除。
GAME_ENVIRONMENT=sandbox
GAME_REPOSITORY=sqlite
GAME_DATABASE_PATH=data/serious_game.db

ROLE_LLM_PROVIDER=openai_compatible
ROLE_LLM_BASE_URL=https://api.qianzhang-ai.cn/v1
ROLE_LLM_MODEL=qwen3.6-plus
ROLE_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=

ROLE_LLM_TIMEOUT_SECONDS=30
ROLE_LLM_MAX_RETRIES=2
ROLE_LLM_MAX_OUTPUT_TOKENS=700
ROLE_LLM_MAX_CALLS_PER_DAY=12
ROLE_LLM_MAX_CALLS_PER_SESSION=120
ROLE_LLM_MAX_TOKENS_PER_SESSION=240000
ROLE_LLM_FALLBACK_TO_FAKE=true
